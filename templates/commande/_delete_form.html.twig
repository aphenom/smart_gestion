{% if(commande.etatLivraison == false) %}
    <table>
        <tr>

            {% if(commande.etatVal == false) %}
                <td>
                    <form method="post" action="{{ path('commande_activate', {'id': commande.id}) }}" onsubmit="return submitEtat('valide')">
                        <input type="hidden" name="_method" value="POST">
                        <input type="hidden" id="valide_comment" name="commentaire" value="">
                        <input type="hidden" name="_token" value="{{ csrf_token('activate' ~ commande.id) }}">
                        <button class="btn btn-success">Valider la commande</button>
                    </form>
                </td>
            {% endif %}

            <td>
                <form method="post" id="relance_form" action="{{ path('commande_relance', {'id': commande.id}) }}" onsubmit="return submitEtat('relance')">
                    <input type="hidden" name="_method" value="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('relance' ~ commande.id) }}">
                    <input type="hidden" id="relance_comment" name="commentaire" value="">
                    <button class="btn btn-warning">A relancer</button>
                </form>
            </td>

            {% if(commande.etatDel == false) %}
            <td>
                <form method="post" action="{{ path('commande_desactivate', {'id': commande.id}) }}"  onsubmit="return submitEtat('annule')">
                    <input type="hidden" name="_method" value="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('desactivate' ~ commande.id) }}">
                    <input type="hidden" id="annule_comment" name="commentaire" value="">
                    <button class="btn btn-danger float-right">Annuler la commande</button>
                </form>
            </td>
            {% endif %}


        </tr>
    </table>


{% endif %}
