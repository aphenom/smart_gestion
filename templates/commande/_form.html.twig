{{ form_start(form, {'attr': {'class': 'form-valide'}}) }}

<div class="control-group form-group" {% if commande.etatProprio == false %} style="display:none" {% endif %}>
    {# Génération du label. #}
    {{ form_label(form.type_commande, "Type de commande * ", {'label_attr': {'class': 'form-label'}})
    }}
    {# Affichage des erreurs pour ce champ précis. #}
    {{ form_errors(form.type_commande) }}
    {# Génération de l'input. #}
    {% if commande.typeCommande %}
        {{ commande.typeCommande|upper }}
        {{ form_widget(form.type_commande, {'attr': {'class': 'form-control', 'style': 'display:none', 'placeholder':"Type de commande", 'onchange':"selectScopeChooseConsequences()", 'onfocus':"hideOption()"}})
        }}
    {% else %}
        {{ form_widget(form.type_commande, {'attr': {'class': 'form-control', 'placeholder':"Type de commande", 'onchange':"selectScopeChooseConsequences()", 'onfocus':"hideOption()"}})
        }}
    {% endif %}
</div>

<div class="control-group form-group commande-tout">
    {# Génération du label. #}
    {{ form_label(form.nom_client, "Nom du client * ", {'label_attr': {'class': 'form-label'}})
    }}
    {# Affichage des erreurs pour ce champ précis. #}
    {{ form_errors(form.nom_client) }}
    {# Génération de l'input. #}
    {{ form_widget(form.nom_client, {'attr': {'class': 'form-control', 'placeholder':"Nom du client", 'required':"required"}})
    }}
</div>

