<div class="control-group form-group commande-tout">
    <button class="btn btn-main-primary pd-x-30 mg-r-5 mg-t-5">{{ button_label|default('Enregistrer') }}</button>
    <input type="reset" class="btn btn-dark pd-x-30 mg-t-5" value="Annuler">
</div>
<div class="control-group form-group">
    <div class="alert alert-secondary">Les champs marqués par (*) doivent être obligatoirement
        remplis.<br />
        <!--Pour les champs marqués par (**) ; au minimum l'un d'entre eux doit être rempli.-->
    </div>
</div>
{{ form_widget(form) }}
{{ form_end(form) }}

<script type="text/javascript">


// and here's the trick (works everywhere)
    function r(f) {
        /in/.test(document.readyState) ? setTimeout('r(' + f + ')', 9) : f()
    }
// use like
    r(function () {
        selectScopeChooseConsequences();
    });

    function selectScopeChooseConsequences() {
        //alert(object.value);
        val = $('#commande_type_commande').val();
        //alert(val);
        if (val != "") {
            $('.commande-tout').fadeIn("slow");
            $('#commande_nom_client').attr('required', true);
            //facebook
            if (val == "reseaux sociaux" || val == "service livraison") {
                $('.commande-fb-jumia').fadeIn("slow");
                $('#commande_numero_client').attr('required', true);
                $('#commande_lieu_livraison').attr('required', true);
                $('#commande_frais_livraison').attr('required', true);
                //$('#commande_lieu_livraison').val('');
                $('.commande-fb').fadeIn("slow");
            } else {
                if (val == "jumia") {
                    $('.commande-fb-jumia').fadeIn("slow");
                    $('#commande_numero_client').attr('required', false);
                    $('#commande_lieu_livraison').attr('required', true);
                    $('#commande_lieu_livraison').val('JUMIA');
                    //$('#commande_lieu_livraison').attr('readonly', true);
                    $('#commande_frais_livraison').attr('required', true);
                } else { //locale
                    $('#commande_numero_client').attr('required', false);
                    $('.commande-fb-jumia').fadeOut("slow");
                    $('.commande-fb').fadeOut("slow");
                    //$('#commande_lieu_livraison').attr('required', false);
                    $('#commande_lieu_livraison').val('');
                    $('#commande_lieu_livraison').attr('readonly', false);
                    $('#commande_frais_livraison').attr('required', false);
                }
            }
        }
        //locale
        else {
            $('.commande-fb-jumia').fadeOut("slow");
            $('.commande-fb').fadeOut("slow");
            $('.commande-tout').fadeOut("slow");
        }
        /*
         if (val == "hide") {
         $('#btn_password').fadeIn("slow");
         $('#btn_password_reset').fadeOut("slow");
         $('#user_password').fadeOut("slow");
         $('#user_password').val($('#user_text_password').val());
         } else {
         $('#btn_password').fadeOut("slow");
         $('#btn_password_reset').fadeIn("slow");
         $('#user_password').fadeIn("slow");
         $('#user_password').val("");
         }
         */

    }


    function hideOption() {
    {% if commande.etatProprio == true %} 
        $("#commande_type_commande option[value='service livraison']").remove();
    {% endif %}
        }
</script>