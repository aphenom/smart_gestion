{% extends 'base.html.twig' %}

{% block title %}Commande{% endblock %}

{% block body %}
    <h1>Commande</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ commande.id }}</td>
            </tr>
            <tr>
                <th>Type_commande</th>
                <td>{{ commande.typeCommande }}</td>
            </tr>
            <tr>
                <th>Nom_client</th>
                <td>{{ commande.nomClient }}</td>
            </tr>
            <tr>
                <th>Numero_client</th>
                <td>{{ commande.numeroClient }}</td>
            </tr>
            <tr>
                <th>Lieu_livraison</th>
                <td>{{ commande.lieuLivraison }}</td>
            </tr>
            <tr>
                <th>Frais_livraison</th>
                <td>{{ commande.fraisLivraison }}</td>
            </tr>
            <tr>
                <th>Montant_recu</th>
                <td>{{ commande.montantRecu }}</td>
            </tr>
            <tr>
                <th>Sku</th>
                <td>{{ commande.sku }}</td>
            </tr>
            <tr>
                <th>Date_add</th>
                <td>{{ commande.dateAdd ? commande.dateAdd|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Date_del</th>
                <td>{{ commande.dateDel ? commande.dateDel|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Etat_val</th>
                <td>{{ commande.etatVal ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Etat_del</th>
                <td>{{ commande.etatDel ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Date_livraison</th>
                <td>{{ commande.dateLivraison ? commande.dateLivraison|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Etat_livraison</th>
                <td>{{ commande.etatLivraison ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Date_retour</th>
                <td>{{ commande.dateRetour ? commande.dateRetour|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Etat_retour</th>
                <td>{{ commande.etatRetour ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('commande_index') }}">back to list</a>

    <a href="{{ path('commande_edit', {'id': commande.id}) }}">edit</a>

    {{ include('commande/_delete_form.html.twig') }}
{% endblock %}
