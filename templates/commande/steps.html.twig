{% extends 'base.html.twig' %}

{% block title %}Logistique Commande{% endblock %}

{% block css %}
    <!-- Internal Data table css -->
    <link href="{{ asset('plugins/datatable/css/dataTables.bootstrap4.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('plugins/datatable/css/buttons.bootstrap4.min.css') }}" rel="stylesheet">
    <link href="{{ asset('plugins/datatable/css/responsive.bootstrap4.min.css') }}" rel="stylesheet" />
    <link href="{{ asset('plugins/datatable/css/jquery.dataTables.min.css') }}" rel="stylesheet">
    <link href="{{ asset('plugins/datatable/css/responsive.dataTables.min.css') }}" rel="stylesheet">
    <link href="{{ asset('plugins/select2/css/select2.min.css') }}" rel="stylesheet">
    <link href="{{ asset('plugins/select2/css/select2.min.css') }}" rel="stylesheet">

    {{ parent() }}

{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12 col-lg-6">
            <div class="card">
                <div class="card-header pb-0">
                    <div class="row"><div class="col-lg-8 col-md-8 main-content-label"><h3>Commande</h3></div>
                        {% if(commande.etatLivraisonAgent == false and is_granted('ROLE_LIV') and commande.etatProprio == false) %}
                            <div class="col-lg-4 col-md-4"><a href="{{ path('commande_edit', {'id': commande.id}) }}" class="btn mb-1 btn-success btn-xs">Modifier</a></div>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            <tr>
                                <th>#</th>
                                <td>{{ commande.sku }}</td>
                            </tr>
                            <tr>
                                <th>Type de commande</th>
                                <td>{{ commande.typeCommande|upper }}</td>
                            </tr>
                            <tr>
                                <th>Nom du client</th>
                                <td>{{ commande.nomClient }}</td>
                            </tr>
                            <tr>
                                <th>Contact du client</th>
                                <td>{{ commande.numeroClient }}</td>
                            </tr>
                            {% if commande.typeCommande != 'locale' %}
                                <tr>
                                    <th>Lieu de livraison</th>
                                    <td>{{ commande.lieuLivraison }}</td>
                                </tr>
                                <tr>
                                    <th>Date de livraison souhaitée</th>
                                    <td>{{ commande.dateLivraisonSouhaite ? commande.dateLivraisonSouhaite|date('d-m-Y H:i:s') : '' }}</td>
                                </tr>
                                <tr>
                                    <th>Frais de livraison</th>
                                    <td>{{ commande.fraisLivraison|number_format(0, ',', '.') }} FCFA</td>
                                </tr>
                            {% endif %}

                            {% if commande.etatLivraison == true %}
                                <tr>
                                    <th>Livreur </th>
                                    <td>{{ commande.agentLivreur.user.displayName }}</td>
                                </tr>
                            {% endif %}

                            <tr>
                                <th>Ajoutée le</th>
                                <td>{{ commande.dateAdd ? commande.dateAdd|date('d-m-Y H:i:s') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Ajouté par </th>
                                <td>{{ commande.userAdd.displayName }}</td>
                            </tr>
                            <tr>
                                <td colspan="2"> 
                                    <div class="card-header" id="heading1" role="tab">
                                        <a aria-controls="collapse1" aria-expanded="false" class="collapsed" data-toggle="collapse" href="#collapse1"><b>Voir l'historique</b></a>
                                    </div>
                                    <div aria-labelledby="heading1" class="collapse" data-parent="#heading1" id="collapse1" role="tabpanel">
                                        <div class="card-body">
                                            <table class="table text-md-nowrap">
                                                <thead>
                                                    <tr>
                                                        <th class="wd-15p border-bottom-0">Date</th>
                                                        <th class="wd-15p border-bottom-0">Etat</th>
                                                        <th class="wd-50p border-bottom-0">Commentaire</th>
                                                        <th class="wd-20p border-bottom-0">utilisateur</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for historique in commande.historiques|reverse %}
                                                        <tr>
                                                            <td>{{ historique.date ? historique.date|date('d-m-Y H:i:s') : '' }}</td>
                                                            <td>{{ historique.step['etatLibelle'] }}</td>
                                                            <td><i>{{ historique.commentaire }}</i></td>
                                                            <td><i>{{ historique.user.displayName  }}</i></td>
                                                        </tr>
                                                    {% else %}
                                                        Aucune information disponible.
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </td>
                                {#                                <td>{{ commande.commentaire }}</td>#}
                            </tr>
                        </tbody>
                    </table>
                    <a href="{{ path('commande_global_index', {'role': role, 'etat': etat}) }}"><i class="fa fa-arrow-left"></i> Rétourner à la liste</a>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header pb-0">
                    <div class="row"><div class="col-lg-8 col-md-8 main-content-label"><h3>Gestion</h3></div>
                    </div>
                </div>
                <div class="card-body">

                    <div class="alert alert-{{ commande.etat['etatCouleur'] }}" role="alert" id='message-info'>
                        <a href="#" class="alert-link">{{ commande.etat['etatLibelle'] }}</a> - <i>Depuis le {{ commande.etat['etatDate']  ? commande.etat['etatDate']|date('d-m-Y H:i:s') : '' }}</i> 
                        {% if(commande.etatRelance == true) %}<span class='badge badge-warning'>"A relancer" Signalé</span> {% endif %}
                        {% if(commande.etatDel == true) %}<span class='badge badge-danger'>"Annulation" Signalée</span> {% endif %}
                    </div>

                    <div class="card">
                        <div class="card-body"> {{ include('commande/_steps_form.html.twig') }}</div>
                    </div>
                </div>
            </div>
        </div>

        {% if(commande.etatProprio == true) %}
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered text-md-nowrap" id="example1">
                                <thead>
                                    <tr>
                                        <th class="wd-5p border-bottom-0">#</th>
                                        <th class="wd-10p border-bottom-0">Code</th>                
                                        <th class="wd-20p border-bottom-0">Nom</th>
                                        <th class="wd-15p border-bottom-0">Image</th>
                                        <th class="wd-15p border-bottom-0">Prix Unitaire Vente (FCFA)</th>
                                        {% if(is_granted('ROLE_ADMIN')) %}
                                        <th class="wd-15p border-bottom-0">Prix Unitaire Achat (FCFA)</th>
                                          {% endif %}
                                        <th class="wd-5p border-bottom-0">Quantité</th>
                                        <th class="wd-15p border-bottom-0">Prix total (FCFA)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for ca in commandeArticles|reverse %}
                                        <tr>
                                            <td>{{ loop.index}}</td>
                                            <td>{{ ca.article.sku }}</td>
                                            <td>{{ ca.article.nom }}</td>
                                            <td>
                                                {% if ca.article.etatProprio %}
                                                    <img alt="Responsive image" class="img-thumbnail wd-100p wd-sm-200" src="{{ vich_uploader_asset(ca.article, 'imageFile') }}">
                                                {% else %}
                                                    Titulaire : {{ ca.article.nomProprio }}                                    
                                                {% endif %}
                                            </td>
                                            <td>{{ ca.puVenteFinal|number_format(0, ',', '.') }}</td>
                                            {% if(is_granted('ROLE_ADMIN')) %}
                                            <td>{{ ca.puAchat|number_format(0, ',', '.') }}</td>
                                          {% endif %}
                                            <td>{{ ca.quantite }}</td>
                                            <td>{{ ca.total|number_format(0, ',', '.') }}</td>
                                            {#<td><span class="badge {{ ca.article.etatVal ? 'badge-success' : 'badge-danger' }}">{{ ca.article.etatVal ? 'Actif' : 'Inactif' }}</span></td>#}
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="10" align="center">Aucune donnée trouvée</td>
                                        </tr>
                                    {% endfor %}
                                    <tr>
                                        <td colspan="{{ is_granted('ROLE_ADMIN') == true ? 7:6 }}" align="right">Total</td>
                                        <td align="right">{{ commande.totalCommandeArticle|number_format(0, ',', '.') }} FCFA</td>
                                    </tr>
                                    <tr>
                                        <td colspan="{{ is_granted('ROLE_ADMIN') == true ? 7:6 }}" align="right">Frais de livraison</td>
                                        <td align="right">{{ commande.fraisLivraison|number_format(0, ',', '.') }} FCFA</td>
                                    </tr>
                                    <tr>
                                        <td colspan="{{ is_granted('ROLE_ADMIN') == true ? 7:6 }}" align="right">Total Net à payer</td>
                                        <td align="right">{{ commande.total|number_format(0, ',', '.') }} FCFA</td>
                                    </tr>
                                </tbody>
                            </table>                    </div>

                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block script %} 

    {{ parent() }}
    <!--- Select2 js --->
    <script src="{{ asset('plugins/select2/js/select2.min.js') }}"></script>
    <script type="text/javascript">
        $("document").ready(function () {
            $('select[data-select="true"').select2();
        });

        function visibleForm(type, btn) {
            //initForm(hide, submit, cancel);
            //console.log($(btn).html());
            $('#steps_commentaire').val("");
            $('#form-submit').attr('onClick', "submitForm('" + type + "')");
            $('#form-cancel').attr('onClick', "cancelForm('" + type + "')");
            $('#form-submit').html($(btn).html());
            $('#btn-' + type).fadeOut("slow");
            $('#btn-' + type).siblings().fadeOut("slow");
            if (type == "start-livraison") {
                $('#form-agent').fadeIn("slow");
                $('#steps_agent_livreur').attr('required', 'required');
            }
            $('#form-bloc').fadeIn("slow");
        }

        function submitForm(type) {

            retro_etat_val = valBool($('#steps_etat_val').val());
            retro_etat_lancement = valBool($('#steps_etat_lancement').val());
            retro_etat_livraison = valBool($('#steps_etat_livraison').val());
            retro_etat_livraison_agent = valBool($('#steps_etat_livraison_agent').val());
            retro_etat_livraison_val = valBool($('#steps_etat_livraison_val').val());
            retro_etat_comptabilite = valBool($('#steps_etat_comptabilite').val());

            if (retro_etat_comptabilite == 1) {
                retro_etat_comptabilite = 0;
            } else if (retro_etat_livraison_val == 1) {
                retro_etat_livraison_val = 0;
            } else if (retro_etat_livraison_agent == 1) {
                retro_etat_livraison_agent = 0;
            } else if (retro_etat_livraison == 1) {
                retro_etat_livraison = 0;
            } else if (retro_etat_lancement == 1) {
                retro_etat_lancement = 0;
            } else if (retro_etat_val == 1) {
                retro_etat_val = 0;
            }

            if (type != "") {
                switch (type) {
                    case "start-lancement":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir lancer le traitement de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 0, 0, 0, 0, 'etat_lancement');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;
                    case "cancel-lancement":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir annuler le lancement du traitement de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 0, 0, 0, 0, 0, 'etat_lancement_cancel');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;

                    case "start-livraison":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir lancer la livraison de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 1, 0, 0, 0, 'etat_livraison');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;
                    case "cancel-livraison":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir annuler le lancement de la livraiosn de cette commande ?');
                        if (r == true) {
                            $('#steps_agent_livreur').val('');
                            remplirBool(1, 0, 0, 1, 0, 0, 0, 0, 'etat_livraison_cancel');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;

                    case "start-livraison-agent":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir vouloir valider le retour livreur de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 1, 1, 0, 0, 'etat_livraison_agent');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;
                    case "cancel-livraison-agent":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir annuler la validation du retour livreur de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 1, 0, 0, 0, 'etat_livraison_agent_cancel');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;

                    case "start-livraison-val":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir vouloir valider la livraion de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 1, 1, 1, 0, 'etat_livraison_val');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;
                    case "cancel-livraison-val":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir annuler la validation de la livraison de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 1, 1, 0, 0, 'etat_livraison_val_cancel');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;

                    case "start-comptabilite":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir vouloir valider la comptabilité de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 1, 1, 1, 1, 'etat_comptabilite');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;
                    case "cancel-comptabilite":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir annuler la validation de la comptabilité de cette commande ?');
                        if (r == true) {
                            remplirBool(1, 0, 0, 1, 1, 1, 1, 0, 'etat_comptabilite_cancel');
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;

                    case "relance":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir signaler à relancer cette commande ?');
                        if (r == true) {
                            remplirBool(retro_etat_val, 1, 0, retro_etat_lancement, retro_etat_livraison, retro_etat_livraison_agent, retro_etat_livraison_val, retro_etat_comptabilite, "etat_relance");
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;

                    case "delete":
                        // code block
                        r = confirm('Êtes-vous sûr(e) de vouloir annuler définitivement cette commande ?');
                        if (r == true) {
                            remplirBool(retro_etat_val, 0, 1, retro_etat_lancement, retro_etat_livraison, retro_etat_livraison_agent, retro_etat_livraison_val, retro_etat_comptabilite, "etat_del");
                            $('#myForm').attr('onSubmit', 'return true');
                            $("#myForm").submit();
                        }
                        break;
                }
            }

        }

        function remplirBool(etat_val, etat_relance, etat_del, etat_lancement, etat_livraison, etat_livraison_agent, etat_livraison_val, etat_comptabilite, type_etat) {
            $('#steps_etat_val').val(etat_val);
            $('#steps_etat_relance').val(etat_relance);
            $('#steps_etat_del').val(etat_del);
            $('#steps_etat_lancement').val(etat_lancement);
            $('#steps_etat_livraison').val(etat_livraison);
            $('#steps_etat_livraison_agent').val(etat_livraison_agent);
            $('#steps_etat_livraison_val').val(etat_livraison_val);
            $('#steps_etat_comptabilite').val(etat_comptabilite);
            $('#steps_type_etat').val(type_etat);
        }

        function cancelForm(type) {
            $('#steps_commentaire').val("");
            $('#form-submit').attr('onClick', '');
            $('#form-cancel').attr('onClick', '');
            $('#myForm').attr('onSubmit', 'return false');
            $('#form-submit').html('');
            if (type == "start-livraison") {
                $('#form-agent').fadeOut("slow");
                $('#steps_agent_livreur').val('');
                $('#steps_agent_livreur').attr('required', false);
            }
            $('#form-bloc').fadeOut("slow");
            $('#btn-' + type).fadeIn("slow");
            $('#btn-' + type).siblings().fadeIn("slow");
        }

        function valBool(bool) {
            if (bool == "1") {
                return 1;
            } else {
                return 0;
            }
        }

    </script>

    <script>
        function print(pdf) {
            //$('#global-loader').fadeIn("slow");
            // Créer un IFrame.
            var iframe = document.createElement('iframe');
            // Cacher le IFrame.    
            iframe.style.visibility = "hidden";
            // Définir la source.    
            iframe.src = pdf;
            // Ajouter le IFrame sur la page Web.    
            document.body.appendChild(iframe);
            iframe.contentWindow.focus();
            //$('#global-loader').fadeout("slow");
            iframe.contentWindow.print(); // Imprimer.
            //$('#global-loader').fadeout("slow");
        }
    </script>

{% endblock %} 