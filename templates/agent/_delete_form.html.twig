{% if(agent.etatVal == true) %}

    <form method="post" action="{{ path('agent_desactivate', {'id': agent.id}) }}" onsubmit="return confirm('Êtes-vous sûre de vouloir désactiver cet enregistrement ?');">
        <input type="hidden" name="_method" value="POST">
        <input type="hidden" name="_token" value="{{ csrf_token('desactivate' ~ agent.id) }}">
        <button class="btn btn-danger">Désactiver</button>
    </form>

{% else %}

    <form method="post" action="{{ path('agent_activate', {'id': agent.id}) }}" onsubmit="return confirm('Êtes-vous sûre de vouloir réactiver cet enregistrement ?');">
        <input type="hidden" name="_method" value="POST">
        <input type="hidden" name="_token" value="{{ csrf_token('activate' ~ agent.id) }}">
        <button class="btn btn-success">Activer</button>
    </form>

{% endif %}
