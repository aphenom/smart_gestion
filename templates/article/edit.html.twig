{% extends 'base.html.twig' %}

{% block title %}Modifier Article{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="main-content-label mg-b-5">
                        <h3>Modifier Article</h3>
                    </div>

                    {{ include('article/_form.html.twig', {'button_label': 'Modifier'}) }}

                    <div class="row m-b-30">
                        <div class="col-auto"><a class="btn mb-1 btn-outline-primary" href="{{ path('article_index') }}"><i class="fa fa-arrow-left"></i> Rétourner à la liste</a></div>
                        <div class="col-auto">{{ include('article/_delete_form.html.twig') }}</div>
                    </div>

                </div>
            </div>
        </div>
    </div>       
{% endblock %}
