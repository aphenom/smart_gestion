{% extends 'base.html.twig' %}

{% block title %}Réduire Stock Article{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="main-content-label mg-b-5">
                        <h3>Réduire stock article - {{ debitArticle.article.nom }}</h3>
                    </div>

                    {{ include('article/_debit_form.html.twig') }}

                    <a href="{{ path('article_show', {'id': debitArticle.article.id}) }}"><i class="fa fa-arrow-left"></i> Rétourner à l'article</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
