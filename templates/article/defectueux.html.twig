{% extends 'base.html.twig' %}

{% block title %}Signaler Article Défectueux{% endblock %}

{% block css %}
    <link href="{{ asset('plugins/select2/css/select2.min.css') }}" rel="stylesheet">

    {{ parent() }}

{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="main-content-label mg-b-5">
                        <h3>Signaler Article Défectueux</h3>
                    </div>

                    {{ include('article/_defectueux_form.html.twig') }}

                    <a href="{{ path('article_index') }}"><i class="fa fa-arrow-left"></i> Rétourner à la liste</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block script %} 

    {{ parent() }}
    <!--- Select2 js --->
    <script src="{{ asset('plugins/select2/js/select2.min.js') }}"></script>
    <script type="text/javascript">
        $("document").ready(function () {

            $('select[data-select="true"').select2();

        });

    </script>

{% endblock %} 