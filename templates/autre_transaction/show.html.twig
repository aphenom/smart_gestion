{% extends 'base.html.twig' %}

{% block title %}Fiche Transaction{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="main-content-label mg-b-5">
                        <h3>Fiche Transaction</h3>
                    </div>

                    <table class="table">
                        <tbody>
                            <tr>
                                <th>Type de transaction</th>
                                <td><span class="badge {{ autre_transaction.typeTransaction == 'entree' ? 'badge-success' : 'badge-danger' }}">{{ autre_transaction.typeTransaction|upper }}</span></td>
                            </tr>
                            <tr>
                                <th>Montant</th>
                                <td><font class="{{ autre_transaction.typeTransaction == 'entree' ? 'tx-success' : 'tx--danger' }}">{{ autre_transaction.typeTransaction == 'entree' ? '+' : '-' }} {{ autre_transaction.montant|number_format(0, ',', '.') }} FCFA</font></td>
                            </tr>
                            <tr>
                                <th>Objet</th>
                                <td>{{ autre_transaction.objet }}</td>
                            </tr>
                            <tr>
                                <th>Date Ajout</th>
                                <td>{{ autre_transaction.dateAdd ? autre_transaction.dateAdd|date('d-m-Y H:i:s') : '' }}</td>
                            </tr>
{#                            <tr>
                                <th>Etat</th>
                                <td><span class="badge {{ autre_transaction.etatVal ? 'badge-success' : 'badge-danger' }}">{{ autre_transaction.etatVal ? 'Actif' : 'Inactif' }}</span></td>
                            </tr>#}
                        </tbody>
                    </table>

                    <div class="row m-b-30">
                        <div class="col-auto"><a class="btn mb-1 btn-outline-primary" href="{{ path('autre_transaction_index') }}"><i class="fa fa-arrow-left"></i> Rétourner à la liste</a></div>
                        <div class="col-auto"><a class="btn mb-1 btn-primary" href="{{ path('autre_transaction_edit', {'id': autre_transaction.id}) }}">Modifier</a></div>
                    </div>
{#                    <div class="row m-b-30">
                        <div class="col-auto"> 
                            {{ include('agent/_delete_form.html.twig') }}
                        </div>
                    </div>#}

                </div>
            </div>
        </div>
    </div> 
{% endblock %}
